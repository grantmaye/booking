NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DB_PATH=/app/data/chairside.sqlite
PUBLIC_ORIGIN=https://booking.example.com
APP_DOMAIN=booking.example.com
# Generate independent values with: openssl rand -hex 32
APP_SECRET=
SETUP_TOKEN=
RUN_WORKER=true
SEED_DEMO=false
# Configure a restricted Stripe API key and the endpoint signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Verified sending domain required.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=
# Optional SMS provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
