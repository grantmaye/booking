{
  "name": "chairside-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "web": "expo start --web",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "export": "expo export --platform all",
    "build:ios": "APP_VARIANT=development expo run:ios",
    "build:android": "APP_VARIANT=development expo run:android",
    "preview:web": "EXPO_PUBLIC_LOCAL_PREVIEW=true EXPO_PUBLIC_API_URL=http://127.0.0.1:8082 expo export --platform web && node scripts/preview.mjs",
    "assets": "node scripts/brand-assets.mjs",
    "test": "node --test test/*.test.ts"
  },
  "private": true
}
