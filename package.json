    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "deploy:check": "node --env-file-if-exists=.env scripts/preflight.mjs",
    "format": "prettier --write .",
    "test:release": "node scripts/release-smoke.mjs"
  },
  "dependencies": {
    "otpauth": "^9.6.0",
    "stripe": "^23.1.0",
    "svix": "^2.9.1"
  },
